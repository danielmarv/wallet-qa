{
  "name": "wallet-qa",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "build": "pnpm run build:web && pnpm run build:spa && pnpm run build:server",
    "build:web": "rm -rf dist && mkdir -p dist/public && cp -R public/. dist/public/",
    "build:spa": "pnpm --filter @wallet-qa/web build",
    "dev:spa": "pnpm --filter @wallet-qa/web watch",
    "build:server": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server/server.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "pnpm run build && pnpm test",
    "fixtures:generate": "node scripts/generate-fixtures.mjs",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@eudiplo/sdk-core": "7.6.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.19"
  },
  "packageManager": "pnpm@11.20.0"
}
